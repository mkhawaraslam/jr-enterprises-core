      "mainEntity": [
        {
          "@type": "Question",
          "name": "What industrial products does J.R Enterprises supply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "J.R Enterprises supplies industrial valves, steam traps, fittings, tubing, pneumatic and hydraulic components, air service units, measuring instruments, and automation components. The catalogue groups product photos into ten collections."
          }
        },
        {
          "@type": "Question",
          "name": "Where is J.R Enterprises located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "J.R Enterprises is based at Crystal Arcade, Opp-Main Moblink Franchise, LMQ Road, Multan, Pakistan, and supplies industrial customers across Pakistan and abroad."
          }
        },
        {
          "@type": "Question",
          "name": "How can I request a product quotation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Send your product specification and quantity by WhatsApp to +92 302 6500974 or email javaid@jrenterprisespk.com. Include your operating requirements and delivery location so the team can discuss pricing and availability."
          }
        },
        {
          "@type": "Question",
          "name": "Are product prices published online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Products are supplied on a quotation basis rather than with published online prices. Contact J.R Enterprises with your specification, quantity, and delivery location to confirm pricing and availability."
          }
        },
        {
          "@type": "Question",
          "name": "Can J.R Enterprises help with technical product selection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. J.R Enterprises provides technical supply guidance. Share the application, working pressure, temperature, material, and connection requirements so the team can discuss suitable component specifications."
          }
        },
        {
          "@type": "Question",
          "name": "What details should I include in a quotation request?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Include the product type or model, quantity, connection sizes, dimensions, required material, operating pressure and temperature, and delivery location. A reference photo or existing part number can help identify the component."
          }
        }
      ]
